{% extends 'base.html.twig' %}
{% block title %}Revisar anúncio | Casa & Costa{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Moderação de anúncios</span><h1>{{ property.title }}</h1><p class="muted">{{ property.agency.name }} · {{ property.city }}/{{ property.state }} · Código {{ property.id }}</p></div><a class="button secondary" href="{{ path('admin_properties_index') }}">Voltar à lista</a></div>
<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:22px;align-items:start">
<section class="card"><h2>Detalhes do anúncio</h2><p><strong>Moderação:</strong> {{ property.moderationStatus.label }}</p><p><strong>Status comercial:</strong> {{ property.status.value }}</p><p><strong>Finalidade:</strong> {{ property.listingType.label }}</p><p><strong>Tipo:</strong> {{ property.propertyType.label }}</p><p><strong>Preço:</strong> R$ {{ property.price|number_format(2, ',', '.') }}</p><p><strong>Área:</strong> {{ property.areaM2 ? property.areaM2 ~ ' m²' : 'Não informada' }}</p><p><strong>Quartos / banheiros / vagas:</strong> {{ property.bedrooms ?? '—' }} / {{ property.bathrooms ?? '—' }} / {{ property.parkingSpaces ?? '—' }}</p><p><strong>Endereço:</strong> {{ property.neighborhood ?: 'Bairro não informado' }}{% if property.street %}, {{ property.street }}{% endif %}{% if property.streetNumber %}, {{ property.streetNumber }}{% endif %}</p><h3>Descrição</h3><p style="white-space:pre-line">{{ property.description }}</p></section>
<section class="card"><h2>Fotos</h2>{% if property.images|length %}<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px">{% for image in property.images %}<figure><img src="{{ asset(image.thumbnailPath ?: image.filePath) }}" alt="{{ image.altText ?: ('Foto do imóvel ' ~ property.title) }}" style="width:100%;height:150px;object-fit:cover;border-radius:12px"><figcaption class="muted">Foto {{ loop.index }}{% if image.altText %}: {{ image.altText }}{% endif %}</figcaption></figure>{% endfor %}</div>{% else %}<p class="muted">Este anúncio ainda não possui fotos.</p>{% endif %}</section>
<section class="card"><h2>Destaque editorial</h2>
{% if currentHighlight %}
<p><strong>Período:</strong> {{ currentHighlight.startsAt|date('d/m/Y H:i') }} até {{ currentHighlight.endsAt|date('d/m/Y H:i') }}</p>
<p><strong>Concedido por:</strong> {{ currentHighlight.grantedBy ? currentHighlight.grantedBy.fullName : 'Conta removida' }}</p><p><strong>Motivo:</strong> {{ currentHighlight.reason }}</p>
{% if currentHighlight.startsAt > now %}<p class="muted">Este destaque está agendado e ainda não aparece no catálogo.</p>{% else %}<p class="muted">Este destaque está vigente. A exibição pública também depende da aprovação, publicação e situação da imobiliária.</p>{% endif %}
<form method="post" action="{{ path('admin_properties_remove_highlight', {id: property.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-property-remove-highlight-' ~ property.id) }}"><div class="field"><label for="highlight-remove-reason">Motivo da remoção</label><input id="highlight-remove-reason" name="reason" maxlength="1000" required></div><button type="submit" class="button secondary">Remover destaque</button></form>
{% else %}
<p class="muted">Este imóvel não possui destaque vigente ou agendado.</p>
{% endif %}
{% if highlightEligible %}
<form method="post" action="{{ path('admin_properties_highlight', {id: property.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-property-highlight-' ~ property.id) }}"><div class="field"><label for="highlight-start">Início</label><input id="highlight-start" type="datetime-local" name="starts_at" value="{{ defaultHighlightStart }}" required></div><div class="field"><label for="highlight-end">Término (até 90 dias)</label><input id="highlight-end" type="datetime-local" name="ends_at" value="{{ defaultHighlightEnd }}" required></div><div class="field"><label for="highlight-reason">Motivo editorial</label><textarea id="highlight-reason" name="reason" rows="3" maxlength="1000" required placeholder="Por que este imóvel foi selecionado?"></textarea></div><button type="submit">Conceder destaque</button></form>
{% else %}<p class="muted">Para receber destaque, o anúncio precisa estar publicado, aprovado e pertencer a uma imobiliária ativa.</p>{% endif %}
<p class="muted">Regra editorial do MVP: no máximo 6 imóveis aparecem na página inicial, ordenados pela concessão mais recente. Cada período pode durar até 90 dias. O destaque não altera o status comercial ou de moderação.</p>
</section>
<section class="card"><h2>Decisão de moderação</h2><p>Escolha uma decisão. Rejeição e solicitação de ajustes exigem um motivo claro para a imobiliária.</p><form method="post" action="{{ path('admin_properties_moderate', {id: property.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-property-moderation-' ~ property.id) }}"><div class="field"><label for="moderation-status">Decisão</label><select id="moderation-status" name="moderation_status" required><option value="approved">Aprovar</option><option value="changes_requested">Solicitar ajustes</option><option value="rejected">Rejeitar</option></select></div><div class="field"><label for="moderation-reason">Motivo / orientação (obrigatório para ajustes ou rejeição)</label><textarea id="moderation-reason" name="reason" rows="4" maxlength="2000" placeholder="Descreva o que precisa ser corrigido"></textarea></div><button type="submit">Registrar decisão</button></form></section>
<section class="card"><h2>Histórico</h2>{% for item in history %}<article style="padding:12px 0;border-bottom:1px solid var(--line)"><strong>{{ item.statusTypeLabel }}: {{ item.previousStatusLabel ?: 'Inicial' }} → {{ item.newStatusLabel }}</strong><p class="muted">{{ item.createdAt|date('d/m/Y H:i') }} · {{ item.actor ? item.actor.fullName : 'Sistema / usuário removido' }}</p>{% if item.reason %}<p>{{ item.reason }}</p>{% endif %}</article>{% else %}<p class="muted">Nenhuma alteração registrada ainda.</p>{% endfor %}</section>
</div>
{% endblock %}
