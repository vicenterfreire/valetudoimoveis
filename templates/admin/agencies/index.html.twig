{% extends 'base.html.twig' %}
{% block title %}Imobiliárias{% endblock %}
{% block body %}
<div class="page-heading">
    <div>
        <span class="eyebrow">Administração do portal</span>
        <h1>Imobiliárias</h1>
        <p class="muted">Analise cadastros, acompanhe o estado de cada parceiro e controle o acesso ao portal.</p>
    </div>
    <a class="button" href="{{ path('admin_agencies_new') }}">Cadastrar imobiliária</a>
</div>

<form method="get" class="toolbar" aria-label="Filtros de imobiliárias">
    <div class="field">
        <label for="agency-search">Buscar por nome ou e-mail</label>
        <input id="agency-search" name="q" value="{{ query }}" type="search" maxlength="100">
    </div>
    <div class="field">
        <label for="agency-status">Status</label>
        <select id="agency-status" name="status">
            <option value="">Todos os status</option>
            {% for option in statusOptions %}
                <option value="{{ option.value }}" {{ selectedStatus == option.value ? 'selected' : '' }}>
                    {% if option.value == 'pending' %}Aguardando análise
                    {% elseif option.value == 'active' %}Ativa
                    {% elseif option.value == 'blocked' %}Bloqueada
                    {% else %}Rejeitada{% endif %}
                </option>
            {% endfor %}
        </select>
    </div>
    <input type="hidden" name="page" value="1">
    <button type="submit">Filtrar</button>
    <a class="button secondary" href="{{ path('admin_agencies_index') }}">Limpar</a>
</form>

<div class="table-wrap" role="region" aria-label="Tabela de imobiliárias. Em telas estreitas, deslize horizontalmente para ver todas as colunas." tabindex="0">
<table>
    <thead><tr><th>Imobiliária</th><th>Local</th><th>Status</th><th>Última decisão</th><th>Ações</th></tr></thead>
    <tbody>
    {% for agency in agencies %}
        <tr>
            <td><strong>{{ agency.name }}</strong><br><span class="muted">{{ agency.email ?: 'Sem e-mail cadastrado' }}</span></td>
            <td>{{ agency.city }}/{{ agency.state }}</td>
            <td>
                {% if agency.status.value == 'pending' %}<strong>Aguardando análise</strong>
                {% elseif agency.status.value == 'active' %}Ativa
                {% elseif agency.status.value == 'blocked' %}Bloqueada
                {% else %}Rejeitada{% endif %}
                {% if agency.statusReason %}
                    <details><summary>Ver motivo</summary><p>{{ agency.statusReason }}</p></details>
                {% endif %}
            </td>
            <td>
                {% if agency.statusChangedAt %}{{ agency.statusChangedAt|date('d/m/Y H:i') }}{% else %}<span class="muted">Sem decisão</span>{% endif %}
                {% if agency.status.value == 'blocked' and agency.blockedAt %}
                    <p class="muted">Bloqueada em {{ agency.blockedAt|date('d/m/Y H:i') }}</p>
                {% endif %}
            </td>
            <td>
                <div class="actions">
                    <a class="button secondary" href="{{ path('admin_agencies_edit', {id: agency.id}) }}">Editar dados</a>
                    {% set hasManager = false %}
                    {% for member in agency.users %}
                        {% if 'ROLE_AGENCY_MANAGER' in member.roles %}{% set hasManager = true %}{% endif %}
                    {% endfor %}
                    {% if not hasManager %}<a class="button" href="{{ path('admin_agency_manager_new', {id: agency.id}) }}">Cadastrar primeiro gestor</a>{% endif %}
                    {% if agency.status.value == 'pending' %}
                        <form method="post" action="{{ path('admin_agencies_approve', {id: agency.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve-agency-' ~ agency.id) }}">
                            <button type="submit">Aprovar</button>
                        </form>
                        <form method="post" action="{{ path('admin_agencies_reject', {id: agency.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject-agency-' ~ agency.id) }}">
                            <label class="visually-hidden" for="reject-reason-{{ agency.id }}">Motivo da rejeição de {{ agency.name }}</label>
                            <input id="reject-reason-{{ agency.id }}" name="reason" placeholder="Motivo da rejeição" maxlength="1000" required>
                            <button class="danger" type="submit">Rejeitar</button>
                        </form>
                    {% elseif agency.status.value == 'active' %}
                        <form method="post" action="{{ path('admin_agencies_block', {id: agency.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('block-agency-' ~ agency.id) }}">
                            <label class="visually-hidden" for="block-reason-{{ agency.id }}">Motivo do bloqueio de {{ agency.name }}</label>
                            <input id="block-reason-{{ agency.id }}" name="reason" placeholder="Motivo do bloqueio" maxlength="1000" required>
                            <button class="danger" type="submit">Bloquear</button>
                        </form>
                    {% elseif agency.status.value == 'blocked' %}
                        <form method="post" action="{{ path('admin_agencies_activate', {id: agency.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('activate-agency-' ~ agency.id) }}">
                            <button type="submit">Reativar</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('admin_agencies_approve', {id: agency.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve-agency-' ~ agency.id) }}">
                            <button type="submit">Aprovar após revisão</button>
                        </form>
                    {% endif %}
                </div>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5">Nenhuma imobiliária corresponde aos filtros informados.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
<div class="pagination-summary" aria-live="polite">
    <p class="muted">{{ totalItems }} imobiliária(s) encontrada(s) · Página {{ page }} de {{ totalPages }}</p>
    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="Paginação de imobiliárias">
            {% if page > 1 %}<a class="button secondary" href="{{ path('admin_agencies_index', {q: query, status: selectedStatus, page: page - 1}) }}" rel="prev">Anterior</a>{% endif %}
            {% for pageNumber in max(1, page - 2)..min(totalPages, page + 2) %}
                {% if pageNumber == page %}<span class="button" aria-current="page">{{ pageNumber }}</span>{% else %}<a class="button secondary" href="{{ path('admin_agencies_index', {q: query, status: selectedStatus, page: pageNumber}) }}">{{ pageNumber }}</a>{% endif %}
            {% endfor %}
            {% if page < totalPages %}<a class="button secondary" href="{{ path('admin_agencies_index', {q: query, status: selectedStatus, page: page + 1}) }}" rel="next">Próxima</a>{% endif %}
        </nav>
    {% endif %}
</div>
{% endblock %}
