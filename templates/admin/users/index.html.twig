{% extends 'base.html.twig' %}
{% block title %}Usuários e permissões | ValeTudo Imóveis{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Administração global</span><h1>Usuários e permissões</h1><p class="muted">Pesquise contas, controle o acesso e revise o papel e a imobiliária associados.</p></div></div>
<form method="get" class="toolbar" aria-label="Filtros de usuários">
    <div class="field"><label for="user-search">Nome ou e-mail</label><input id="user-search" name="q" type="search" maxlength="100" value="{{ query }}"></div>
    <div class="field"><label for="user-active">Status</label><select id="user-active" name="active"><option value="">Todos</option><option value="1" {{ selectedActive == '1' ? 'selected' : '' }}>Ativos</option><option value="0" {{ selectedActive == '0' ? 'selected' : '' }}>Desativados</option></select></div>
    <div class="field"><label for="user-role">Papel</label><select id="user-role" name="role"><option value="">Todos</option>{% for role in roles %}<option value="{{ role }}" {{ selectedRole == role ? 'selected' : '' }}>{{ role == 'ROLE_ADMIN' ? 'Administrador global' : (role == 'ROLE_AGENCY_MANAGER' ? 'Gestor de imobiliária' : 'Funcionário') }}</option>{% endfor %}</select></div>
    <div class="field"><label for="user-agency">Imobiliária</label><select id="user-agency" name="agency"><option value="">Todas / sem vínculo</option>{% for agency in agencies %}<option value="{{ agency.id }}" {{ selectedAgency == agency.id ? 'selected' : '' }}>{{ agency.name }}</option>{% endfor %}</select></div>
    <input type="hidden" name="page" value="1"><button type="submit">Filtrar</button><a class="button secondary" href="{{ path('admin_users_index') }}">Limpar</a>
</form>
<p class="muted">A lista é paginada em grupos de 25 contas. Alterações de papel e status são registradas em auditoria. Não é possível alterar a própria conta por este painel.</p>
<div class="table-wrap" role="region" aria-label="Usuários cadastrados; deslize horizontalmente em telas estreitas" tabindex="0"><table>
<thead><tr><th>Usuário</th><th>Vínculo</th><th>Status</th><th>Permissões e vínculo</th><th>Ações</th></tr></thead><tbody>
{% for member in users %}
<tr>
<td><strong>{{ member.fullName }}</strong><br><span class="muted">{{ member.email }}</span><br><small class="muted">Criado em {{ member.createdAt|date('d/m/Y') }}</small></td>
<td>{{ member.agency ? member.agency.name : 'Sem imobiliária' }}</td>
<td>{{ member.isActive ? 'Ativo' : 'Desativado' }}</td>
<td><form method="post" action="{{ path('admin_users_permissions', {id: member.id}) }}" class="stacked-form">
<input type="hidden" name="_token" value="{{ csrf_token('admin-user-permissions-' ~ member.id) }}">
<label for="role-{{ member.id }}">Papel</label><select id="role-{{ member.id }}" name="role" required>{% for role in roles %}<option value="{{ role }}" {{ role in member.roles ? 'selected' : '' }}>{{ role == 'ROLE_ADMIN' ? 'Administrador global' : (role == 'ROLE_AGENCY_MANAGER' ? 'Gestor de imobiliária' : 'Funcionário') }}</option>{% endfor %}</select>
<label for="agency-{{ member.id }}">Imobiliária (obrigatória para gestor/funcionário)</label><select id="agency-{{ member.id }}" name="agency"><option value="">Sem imobiliária</option>{% for agency in agencies %}<option value="{{ agency.id }}" {{ member.agency and member.agency.id == agency.id ? 'selected' : '' }}>{{ agency.name }}</option>{% endfor %}</select>
<button type="submit" {% if app.user.id == member.id %}disabled{% endif %}>Salvar permissões</button></form></td>
<td><form method="post" action="{{ path('admin_users_status', {id: member.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-user-status-' ~ member.id) }}"><button type="submit" class="{{ member.isActive ? 'danger' : '' }}" {% if app.user.id == member.id %}disabled{% endif %}>{{ member.isActive ? 'Desativar' : 'Ativar' }}</button></form></td>
</tr>
{% else %}<tr><td colspan="5">Nenhum usuário corresponde aos filtros.</td></tr>{% endfor %}
</tbody></table></div>
<div class="pagination-summary" aria-live="polite">
    <p class="muted">{{ totalItems }} usuário(s) encontrado(s) · Página {{ page }} de {{ totalPages }}</p>
    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="Paginação de usuários">
            {% if page > 1 %}<a class="button secondary" href="{{ path('admin_users_index', {q: query, active: selectedActive, role: selectedRole, agency: selectedAgency, page: page - 1}) }}" rel="prev">Anterior</a>{% endif %}
            {% for pageNumber in max(1, page - 2)..min(totalPages, page + 2) %}
                {% if pageNumber == page %}<span class="button" aria-current="page">{{ pageNumber }}</span>{% else %}<a class="button secondary" href="{{ path('admin_users_index', {q: query, active: selectedActive, role: selectedRole, agency: selectedAgency, page: pageNumber}) }}">{{ pageNumber }}</a>{% endif %}
            {% endfor %}
            {% if page < totalPages %}<a class="button secondary" href="{{ path('admin_users_index', {q: query, active: selectedActive, role: selectedRole, agency: selectedAgency, page: page + 1}) }}" rel="next">Próxima</a>{% endif %}
        </nav>
    {% endif %}
</div>
{% endblock %}
