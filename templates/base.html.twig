@media(max-width:640px){.profile-wide{grid-column:auto}.agency-identity{align-items:flex-start;gap:14px}.agency-public-logo{flex-basis:78px;width:78px;height:78px;border-radius:14px}.agency-identity h1{font-size:1.8rem}.agency-contact-list{align-items:stretch;flex-direction:column}.agency-contact-list>*{width:100%;text-align:center}}


.metrics-grid{grid-template-columns:repeat(4,minmax(0,1fr));margin:24px 0}.metric-card{display:flex;flex-direction:column;gap:8px}.metric-card strong{font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.1;letter-spacing:-.04em;color:var(--green)}.metric-card small{line-height:1.45}.section-block{margin-top:34px}.section-block .section-heading{margin-bottom:14px}.section-block table{width:100%;border-collapse:collapse}.section-block th,.section-block td{padding:13px 15px;border-bottom:1px solid var(--line);text-align:left}.section-block th{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.section-block tbody tr:last-child td{border-bottom:0}.card ul{padding-left:1.25rem}.card li+li{margin-top:8px}
@media(max-width:850px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.metrics-grid{grid-template-columns:1fr}.page-heading{align-items:flex-start;gap:16px;flex-direction:column}.form-row{grid-template-columns:1fr}}
.privacy-consent{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:30px auto;padding:18px 22px;max-width:1120px;border:1px solid var(--line);border-radius:16px;background:#f7f9f5}.privacy-consent p{margin:5px 0;font-size:.9rem;color:var(--muted)}.privacy-consent .actions{flex-shrink:0}.privacy-document{max-width:900px;margin:0 auto 44px;padding:clamp(22px,4vw,42px)}.privacy-document h2{margin-top:28px;font-size:1.25rem}.privacy-document p{line-height:1.75}.privacy-document .actions{margin-top:26px}@media(max-width:650px){.privacy-consent{align-items:stretch;flex-direction:column}.privacy-consent .actions{align-items:stretch}.privacy-consent .actions>*{flex:1}}
</style>{% block stylesheets %}{% endblock %}</head>
<body><header><a href="{{ path('home') }}" class="site-logo"><img src="{{ asset('logo-header.webp') }}" style="height: 175px" alt="ValeTudo Imóveis"></a><nav aria-label="Navegação principal"><a href="{{ path('home') }}">Explorar imóveis</a>{% if app.user %}<a href="{{ path('dashboard') }}">Painel</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_agencies_index') }}">Imobiliárias</a><a href="{{ path('admin_users_index') }}">Usuários</a><a href="{{ path('admin_properties_index') }}">Moderação</a><a href="{{ path('admin_usage_reports_index') }}">Relatórios</a>{% endif %}{% if is_granted('ROLE_AGENCY_MANAGER') %}<a href="{{ path('agency_profile_edit') }}">Perfil público</a>{% endif %}<form class="inline nav-logout" action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit">Sair da conta ↗</button></form>{% else %}<a href="{{ path('app_login') }}">Área da imobiliária ↗</a>{% endif %}</nav></header>
<main>{% for m in app.flashes('success') %}<div class="flash">✓ &nbsp; {{ m }}</div>{% endfor %}{% for m in app.flashes('error') %}<div class="flash flash-error">! &nbsp; {{ m }}</div>{% endfor %}{% block body %}{% endblock %}</main>{% if app.session.get('privacy_analytics_consent') is null %}<aside class="privacy-consent" aria-label="Preferências de privacidade"><div><strong>Você controla as métricas opcionais</strong><p>Podemos contar visualizações e cliques de contato de forma agregada. Não registramos IP nem conteúdo de mensagens.</p><a href="{{ path('privacy_notice') }}">Leia o aviso de privacidade</a></div><div class="actions"><form method="post" action="{{ path('privacy_consent') }}"><input type="hidden" name="_token" value="{{ csrf_token('privacy-analytics-consent') }}"><input type="hidden" name="choice" value="accept"><button type="submit">Permitir</button></form><form method="post" action="{{ path('privacy_consent') }}"><input type="hidden" name="_token" value="{{ csrf_token('privacy-analytics-consent') }}"><input type="hidden" name="choice" value="reject"><button class="button button-secondary" type="submit">Recusar</button></form></div></aside>{% endif %}<footer class="site-footer"><div><span>© {{ "now"|date("Y") }} Casa &amp; Costa. Encontrar um lugar, começar uma história.</span><span><a href="{{ path('privacy_notice') }}">Privacidade</a> · Um portal para morar melhor.</span></div></footer><script>
document.addEventListener('error', function (event) {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.hasAttribute('data-image-fallback') || image.dataset.fallbackApplied === 'true') {
        return;
    }
    image.dataset.fallbackApplied = 'true';
    image.removeAttribute('src');
    image.classList.add('image-failed');
    image.alt = 'Foto não disponível';
    image.setAttribute('role', 'img');
    image.setAttribute('aria-label', 'Foto não disponível');
    image.replaceWith(Object.assign(document.createElement('div'), {
        className: 'property-image image-placeholder',
        role: 'img',
        ariaLabel: 'Foto não disponível',
        textContent: 'Foto não disponível'
    }));
}, true);
</script>{% block javascripts %}{% endblock %}</body></html>