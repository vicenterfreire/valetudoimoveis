.home-intro{position:relative;margin:-82px 44px 92px;max-width:540px;color:#cbd9d0}.listing-heading{align-items:end}.results-count{margin-top:8px}.sort-control{display:flex;align-items:center;gap:10px;min-width:250px}.sort-control label{white-space:nowrap;margin:0}.sort-control select{min-width:150px}.property-card{padding:0}.property-card-content{padding:0 20px 20px}.property-card-content h3{margin:8px 0 10px}.property-location{margin:16px 0 0;color:var(--muted);font-size:.87rem}.property-card .price{margin:8px 0}.property-meta{color:var(--muted);font-size:.88rem}.property-details-link{margin-top:4px}.image-placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#e9eee8,#dce5dc);color:#64766c;font-size:.9rem}.image-placeholder span{padding:12px}.property-image.image-failed{display:flex;align-items:center;justify-content:center;object-fit:contain;color:#64766c;background:linear-gradient(135deg,#e9eee8,#dce5dc);font-size:.9rem}.pagination{display:flex;align-items:center;justify-content:center;gap:18px;margin:34px 0 0}.pagination-status{color:var(--muted)}.pagination-disabled{opacity:.5;pointer-events:none}.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
