tton{flex:1}.property-card-content{padding:0 17px 18px}.filter-disclosure>summary{align-items:flex-start}.filter-disclosure>summary .muted{display:none}.active-filters{margin:-14px 9px 28px;align-items:flex-start}.active-filters-label{flex-basis:100%}.search-actions>*{flex:1;text-align:center}}

/* A5: robustez em telas estreitas e preferências de acessibilidade */
*,*::before,*::after{min-width:0}
img,video,iframe{max-width:100%}
main,header,footer,.card,.page-heading,.section-heading{overflow-wrap:anywhere}
.table-wrap{width:100%;max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain;border:1px solid var(--line);border-radius:14px;background:#fff;-webkit-overflow-scrolling:touch}
.table-wrap:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.table-wrap table{min-width:620px;border:0;border-radius:0}
.table-wrap th,.table-wrap td{overflow-wrap:anywhere}
.actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.site-logo img {display: block;height: 512px;width: auto;object-fit: contain;}
.actions form{max-width:100%}
button, .button, nav a, .filter-chip, .detail-gallery-thumb{touch-action:manipulation}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #9a733f;outline-offset:3px}
.flash-error,.filter-errors,.errors{color:#842d28}
@media(max-width:375px){.card{padding:16px}.form-actions,.search-actions{align-items:stretch;flex-direction:column}.form-actions>* , .search-actions>*{width:100%}nav{display:flex;flex-wrap:wrap}nav a{max-width:100%}.detail-specs{gap:8px}.spec{padding:11px}.property-costs>div{align-items:flex-start;flex-direction:column;gap:3px}.property-costs dd{text-align:left}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

/* Perfil público da imobiliária */
.profile-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.8fr);gap:22px;align-items:start}.profile-editor h2,.profile-logo-card h2{margin-bottom:8px}.profile-editor>.muted{margin-bottom:24px}.profile-wide{grid-column:1/-1}.profile-logo-card{position:sticky;top:100px}.agency-logo-preview{display:flex;align-items:center;justify-content:center;min-height:150px;margin:18px 0;padding:20px;border:1px dashed #d5ded5;border-radius:14px;background:#f8faf7}.agency-logo-preview img{display:block;max-width:100%;max-height:180px;object-fit:contain}.agency-logo-empty{flex-direction:column;gap:8px;color:var(--muted)}.agency-logo-empty span{display:grid;place-items:center;width:60px;height:60px;border-radius:18px;background:var(--green);color:white;font:2rem Georgia,serif}.privacy-note{margin-top:22px;padding:15px;border-radius:12px;background:#f5f7f3;font-size:.86rem}.privacy-note p{margin:6px 0 0;color:var(--muted)}.agency-hero{padding:clamp(24px,4vw,42px);border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:var(--shadow)}.agency-identity{display:flex;align-items:center;gap:22px}.agency-identity h1{margin:0 0 7px}.agency-public-logo{display:block;flex:0 0 112px;width:112px;height:112px;padding:10px;border:1px solid var(--line);border-radius:18px;background:#fff;object-fit:contain}.agency-public-logo-fallback{display:grid;place-items:center;background:var(--green);color:white;font:3rem Georgia,serif}.agency-location{margin:0;color:var(--muted)}.agency-description{max-width:850px;margin:26px 0 0;color:#465650;overflow-wrap:anywhere}.agency-contact-list{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:24px}.agency-contact-item{padding:10px 12px;border:1px solid var(--line);border-radius:10px;color:#53645f;background:#f9faf7}.agency-hero+.section-heading{margin-top:42px}
