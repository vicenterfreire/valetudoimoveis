{% extends 'base.html.twig' %}{% block title %}Painel{% endblock %}{% block body %}<div class="dashboard-welcome"><div><span class="eyebrow">Visão geral</span><h1>Olá, {{ app.user.fullName }}.</h1><p>{{ agency.name }} · acompanhe sua operação em um só lugar.</p></div><a class="button" href="{{ path('agency_properties_new') }}">＋ Cadastrar imóvel</a></div><div class="quick-links"><a class="quick-link" href="{{ path('agency_properties_index') }}"><span class="quick-link-icon">⌂</span><span><strong>Seus imóveis</strong><small>Gerencie anúncios e disponibilidade</small></span></a>{% if is_granted('ROLE_AGENCY_MANAGER') %}<a class="quick-link" href="{{ path('agency_users_index') }}"><span class="quick-link-icon">♙</span><span><strong>Equipe</strong><small>Gerencie acessos dos funcionários</small></span></a>{% endif %}<a class="quick-link" href="{{ path('agency_properties_new') }}"><span class="quick-link-icon">＋</span><span><strong>Novo anúncio</strong><small>Cadastre uma nova oportunidade</small></span></a>{% if is_granted('ROLE_AGENCY_MANAGER') %}<a class="quick-link" href="{{ path('agency_profile_edit') }}"><span class="quick-link-icon">◎</span><span><strong>Perfil público</strong><small>Atualize contatos e apresentação</small></span></a>{% endif %}<a class="quick-link" href="{{ path('agency_analytics_index') }}"><span class="quick-link-icon">▥</span><span><strong>Métricas</strong><small>Visualizações e contatos dos anúncios</small></span></a></div><div class="section-heading"><div><span class="eyebrow">Acompanhe de perto</span><h2>Imóveis recentes</h2></div></div><div class="table-wrap"><table><tr><th>Título</th><th>Status</th><th>Preço</th><th></th></tr>{% for p in properties|slice(0,10) %}<tr><td>{{ p.title }}</td><td>{{ p.status.value }}</td><td>R$ {{ p.price|number_format(2,',','.') }}</td><td><a href="{{ path('agency_properties_edit',{id:p.id}) }}">Editar</a></td></tr>{% else %}<tr><td colspan="4">Sem imóveis cadastrados.</td></tr>{% endfor %}</table></div>{% endblock %}
