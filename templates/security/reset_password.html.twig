{% extends 'base.html.twig' %}
{% block title %}Definir nova senha{% endblock %}
{% block body %}
<div class="card" style="max-width:480px;margin:auto">
    <h1>Definir nova senha</h1>
    {% for message in app.flashes('error') %}<p class="errors" role="alert">{{ message }}</p>{% endfor %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('reset-password-' ~ token) }}">
        <label for="password">Nova senha</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="4096" required>
        <label for="password_confirmation">Confirmar nova senha</label>
        <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="4096" required>
        <p><button type="submit">Salvar nova senha</button></p>
    </form>
</div>
{% endblock %}
