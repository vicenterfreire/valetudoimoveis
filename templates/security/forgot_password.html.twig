{% extends 'base.html.twig' %}
{% block title %}Recuperar senha{% endblock %}
{% block body %}
<div class="card" style="max-width:480px;margin:auto">
    <h1>Recuperar senha</h1>
    <p class="muted">Informe o e-mail da sua conta. Se houver uma conta ativa correspondente, enviaremos um link temporário.</p>
    {% for message in app.flashes('success') %}<p class="notice success" role="status">{{ message }}</p>{% endfor %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('forgot-password') }}">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="180" required>
        <p><button type="submit">Enviar instruções</button></p>
    </form>
    <a href="{{ path('app_login') }}">Voltar para entrar</a>
</div>
{% endblock %}
