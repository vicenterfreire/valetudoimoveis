# Copie os valores para variáveis de ambiente do host ou para .env.prod.local fora da área pública.
# Não publique este arquivo preenchido com segredos e não use os valores de exemplo em produção.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_UNICO_DE_PELO_MENOS_32_CARACTERES
APP_SHARE_DIR=var/share
DEFAULT_URI=https://SEU-DOMINIO.example
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/NOME_BANCO?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
MAILER_FROM=no-reply@SEU-DOMINIO.example
MAILER_DSN="smtp://USUARIO:SENHA@SERVIDOR_SMTP:587?encryption=tls&auth_mode=login"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
