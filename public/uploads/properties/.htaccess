Options -Indexes
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp|shtml|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
